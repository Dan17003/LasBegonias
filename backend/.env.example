NODE_ENV=development
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_SSL=false
# In production, download the official RDS global CA bundle and set its local path:
# DB_SSL=true
# DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

# Local development uses disk storage. In AWS, set s3 and use the EC2 IAM role.
DOCUMENT_STORAGE=local
AWS_REGION=
S3_BUCKET=
S3_PREFIX=documentos-clinicos

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PORT=3000
PUBLIC_BACKEND_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:5173
# Generate a unique secret with at least 32 characters; never reuse "secreto".
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# OpenAI-compatible Chat Completions endpoint (use HTTPS outside localhost)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
